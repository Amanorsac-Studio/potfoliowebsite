    {
      "id": "performlive-withdrawn-2026-09",
      "date": "2026-09-14",
      "tag": "Notice",
      "app": "performlive",
      "title": "PerformLive is off the shelf for a moment",
      "body": "Something is wrong with the current build, so I have taken the download down rather than let anyone else install it. It stays in your library, your license is untouched, and a copy already on your machine keeps working. The download returns the moment the fix is out.",
      "url": "performlive.html"
    },
    {
      "id": "harmoniemd-announce",
      "date": "2026-09-09",
      "tag": "Coming soon",
      "app": "harmoniemd",
      "title": "HarmonieMD: walk into rehearsal already knowing your part",
      "body": "A voice note has no isolation. A YouTube link has no parts. A Drive folder has no structure. And nobody is installing a DAW to learn an alto line. HarmonieMD gives every singer their own harmony track to solo, slow to 85% without changing pitch, and loop until the bar lands. For the director it is a real multi-track studio underneath, with non-destructive takes and audio latency that is measured rather than estimated. Songs download once, so rehearsal never depends on the church WiFi. Free for teams up to five. Not ready to download yet; the Hub will say the day it is.",
      "url": "harmoniemd.html"
    }
  ],
  "announcement": {
    "_": "The big panel at the top of the Hub's library. Fill this in and",
    "_2": "every Hub that is open picks it up by itself - it re-reads this",
    "_3": "file a few minutes after you save, and again whenever somebody",
    "_4": "brings the window back to the front. There is no Hub release in",
    "_5": "the loop, and nothing to press.",
    "_6": "",
    "_7": "Delete the whole block, or set live to false, and the panel goes",
    "_8": "back to what it does on its own: offering the update that is",
    "_9": "waiting, or the app in the library that is not installed yet.",
    "_10": "",
    "_11": "starts and ends are optional and are real. Before starts and",
    "_12": "after ends the panel shows nothing, on a Hub already open too,",
    "_13": "so an announcement can be written today and go up on its own.",
    "_14": "",
    "_15": "id is what a dismissal remembers. Change it for a new notice or",
    "_16": "anyone who closed the last one will never see this one.",
    "_17": "",
    "_18": "action is optional. app must be an id from the list below, and",
    "_19": "the button then does the right thing for that app on that",
    "_20": "computer - Install, Update, or Open. url opens in the browser.",
    "live": false,
    "id": "2026-09-launch",
    "eyebrow": "FROM THE STUDIO",
    "headline": "Ten apps. Half price until the thirtieth.",
    "body": "Every paid app in the collection is fifty per cent off until 30 September. PerformLive is free for thirty days while the beta runs.",
    "art": "images/apps/banner-performlive.webp",
    "accent": "#A99CFF",
    "action": {
      "label": "Install PerformLive",
      "app": "performlive"
    },
    "link": {
      "label": "See what is on",
      "url": "https://amanorsac.studio/apps"
    },
    "dismissible": true,
    "starts": null,
    "ends": "2026-09-30T23:59:59Z"
  },
  "promo": {
    "_": "Delete this whole block to end the sale. Nothing else needs editing:",
    "_2": "every price on the site reads list_price_cents against price_cents and",
    "_3": "says nothing at all when this is absent.",
    "_4": "ends is a REAL deadline, not decoration. The countdown on the site is",
    "_5": "drawn from it, and the whole sale - banner, badges, struck-out prices -",
    "_6": "vanishes by itself the moment it passes, on a page already open too.",
    "_7": "Move the date to run the sale longer. Never let it pass and restart:",
    "_8": "a clock that resets is the one thing that would make this dishonest.",
    "_9": "When it does end, put each price_cents back up to its list_price_cents,",
    "_10": "or the old price stops being a price the app was really sold at.",
    "percent": 50,
    "note": "Half price for a limited time",
    "ends": "2026-09-30T23:59:59Z"
