/* =====================================================================
   How Cloudflare builds and serves this site.

   This started as the file Cloudflare offered in its own pull request
   (#1, "Add Cloudflare Workers configuration"), which was never merged -
   so these settings only ever existed in the dashboard. Two things are
   added to it: "main", which gives the Worker some code to run, and the
   two asset options that code needs.

   Without "main" the Worker has no script at all. That is what the
   dashboard means by "a Worker that only has static assets", and it is
   why the functions/ folder was ignored: that folder is a Cloudflare
   Pages convention, and this is a Worker.

   With "main" set, the arrangement is:

     a request matching a file  ->  the file, exactly as before. The
                                    Worker never runs. Every page, image
                                    and font is served as it is today.
     a request matching nothing ->  worker.js, which answers for
                                    /blog/<post> and /sitemap.xml and
                                    hands everything else straight back
                                    to the file server.

   compatibility_date is pinned to what the dashboard reports the live
   Worker already running, so deploying this changes nothing about how
   the runtime behaves.
   ===================================================================== */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "potfoliowebsite",
  "main": "worker.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },

  /* Preview URLs. Every version uploaded without deploying gets its own
     address, <version>-potfoliowebsite.<subdomain>.workers.dev, running
     the real Worker with the real bindings while amanorsac.studio keeps
     serving whatever is deployed. That is how a change is looked at
     before anyone else sees it.

     For this to happen on a push, Workers Builds needs its Version
     command set to "npx wrangler versions upload" - NOT "wrangler
     deploy". With deploy there, every branch published itself over the
     live site, which is exactly what happened in September 2026 when a
     second branch's build took over amanorsac.studio.

     The address is unguessable but not private: lock it behind
     Cloudflare Access if a preview must be for one person only. */
  "preview_urls": true,
  /* The app installers. Too big for Supabase's free plan at 78 MB and
     171 MB, and R2 costs nothing to serve however often they are taken.
     A binding rather than a key: the Worker reaches the bucket because
     Cloudflare hands it the bucket, so there is no credential anywhere
     to leak or rotate. */
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "amanorsac-downloads" }
  ],

  /* Once a day, worker.js's scheduled() runs and emails a review-invite
     link to anyone who downloaded a REVIEW_INVITE_APPS app a week or
     more ago and hasn't already been asked. 15:00 UTC is late morning
     across the US and evening in Europe - no real science to it beyond
     not being the middle of the night anywhere Nebula Tide has actually
     been downloaded so far. */
  "triggers": {
    "crons": ["0 15 * * *"]
  },

  "assets": {
    "directory": ".",
    // worker.js reaches the files through this name
    "binding": "ASSETS"

    /* There is deliberately no "not_found_handling" here.
       Setting it to "404-page" makes the asset layer answer every request
       that does not match a file - and answer it *instead of* running the
       Worker. That is what stopped /blog/<post> and /sitemap.xml from
       ever reaching worker.js: the 404 page they returned was Cloudflare
       serving 404.html directly, which looked exactly like the Worker
       working and was not.
       Left unset, an unmatched request goes to the Worker, which is the
       whole point of having one. worker.js serves 404.html itself for
       anything it does not recognise, so the page a visitor sees is the
       same either way. */
  }
}
